<?xml version="1.0" encoding="utf-8" ?>
<Shell x:Class="Edzio.Desktop.AppShell"
       xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:Edzio.Desktop.Pages"
       Shell.FlyoutBehavior="Disabled">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center" Padding="0,0,8,0">
            <!-- App title (left) -->
            <Label Grid.Column="0" Text="Edzio"
                   TextColor="White" FontSize="18" FontAttributes="Bold"
                   VerticalOptions="Center" Margin="8,0,0,0" />

            <!-- Relay status indicator (right, tappable → Settings) -->
            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnStatusTapped" />
                </HorizontalStackLayout.GestureRecognizers>
                <Ellipse x:Name="StatusDot"
                         WidthRequest="10" HeightRequest="10"
                         Fill="#888888"
                         VerticalOptions="Center" />
                <Label x:Name="StatusLabel"
                       Text="Relay: Checking…"
                       TextColor="White" FontSize="12"
                       VerticalOptions="Center" />
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>

    <ShellContent x:Name="HomeContent" Title="Edzio" Route="home" />
</Shell>
