<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Edzio.Desktop.ViewModels"
             xmlns:controls="clr-namespace:Edzio.Desktop.Controls"
             x:Class="Edzio.Desktop.Pages.ReceivePage"
             x:DataType="vm:ReceiveViewModel"
             Title="Receive">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16" VerticalOptions="Center">
            <Label Text="Receive Files" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />

            <!-- Waiting for the signaling connection -->
            <VerticalStackLayout IsVisible="{Binding IsConnectingToServer}" Spacing="8">
                <Label Text="– – – – – –" FontSize="52" FontAttributes="Bold"
                       HorizontalOptions="Center" TextColor="#CCCCCC" CharacterSpacing="6" />
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="6">
                    <ActivityIndicator IsRunning="True" Color="#0078D4" WidthRequest="16" HeightRequest="16" />
                    <Label Text="Getting you a code…" TextColor="#0078D4" />
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- Pairing code display -->
            <VerticalStackLayout IsVisible="{Binding ShowCode}" Spacing="8">
                <Label Text="Share this code with the sender:" HorizontalOptions="Center" />
                <Label Text="{Binding PairingCode}"
                       FontSize="52" FontAttributes="Bold"
                       HorizontalOptions="Center" TextColor="#0078D4"
                       CharacterSpacing="6" />
                <Label Text="{Binding StatusMessage}" TextColor="#666" HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Progress display -->
            <VerticalStackLayout IsVisible="{Binding ShowProgress}" Spacing="8">
                <Label Text="{Binding StatusMessage}" />
                <controls:TransferProgressView />
            </VerticalStackLayout>

            <!-- Complete display -->
            <VerticalStackLayout IsVisible="{Binding IsComplete}" Spacing="12">
                <Label Text="Transfer Complete!" FontSize="22"
                       HorizontalOptions="Center" TextColor="#107C10" FontAttributes="Bold" />
                <Label Text="{Binding StatusMessage}" HorizontalOptions="Center" />
                <Button Text="Open Downloads Folder" Clicked="OnOpenFolderClicked"
                        BackgroundColor="#0078D4" TextColor="White" CornerRadius="8" />
            </VerticalStackLayout>

            <!-- Initial status (before code, progress, or completion appears) -->
            <Label Text="{Binding StatusMessage}"
                   IsVisible="{Binding ShowInitialStatus}"
                   HorizontalOptions="Center" TextColor="#666" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
